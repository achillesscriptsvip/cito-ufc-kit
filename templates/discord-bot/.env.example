# Copy to .env.local and fill in.
#
# Free Cito API key (500 calls/month, no card): https://citoapi.com/signup/
CITO_API_KEY=your-cito-key

# Discord: Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-token
